{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/market-predictions/weekly-etf/schemas/etf_shared_strategy_state.schema.json",
  "title": "ETF Shared Strategy Decision State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at_utc",
    "report_date",
    "source_repository",
    "source_run_id",
    "authority",
    "source_files",
    "regime",
    "portfolio_context",
    "lanes",
    "promoted_exposures",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "etf_shared_strategy_state_v1"},
    "artifact_type": {"const": "etf_shared_strategy_decision_state"},
    "generated_at_utc": {"type": "string", "minLength": 10},
    "report_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "requested_close_date": {"type": ["string", "null"]},
    "source_repository": {"const": "market-predictions/weekly-etf"},
    "source_run_id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_research_authority",
        "portfolio_mutation",
        "funding_authority",
        "execution_authority",
        "broker_execution_authority",
        "consumer_must_apply_local_implementation_constraints"
      ],
      "properties": {
        "strategy_research_authority": {"const": true},
        "portfolio_mutation": {"const": false},
        "funding_authority": {"const": false},
        "execution_authority": {"const": false},
        "broker_execution_authority": {"const": false},
        "consumer_must_apply_local_implementation_constraints": {"const": true}
      }
    },
    "source_files": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]},
      "required": ["lane_assessment", "runtime_state", "portfolio_state", "macro_policy_pack"]
    },
    "regime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["current", "confidence_pct", "what_changed"],
      "properties": {
        "current": {"type": ["string", "null"]},
        "confidence_pct": {"type": ["number", "null"]},
        "what_changed": {"type": "array", "items": {"type": "string"}},
        "decision_rule": {"type": ["string", "null"]}
      }
    },
    "portfolio_context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["base_currency", "cash_pct", "active_tickers", "context_is_not_consumer_instruction"],
      "properties": {
        "base_currency": {"type": ["string", "null"]},
        "cash_pct": {"type": ["number", "null"]},
        "active_tickers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "context_is_not_consumer_instruction": {"const": true}
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lane"}
    },
    "promoted_exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "exposure_id", "lane_name", "desired_direction"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "exposure_id": {"type": "string", "minLength": 1},
          "lane_name": {"type": "string", "minLength": 1},
          "desired_direction": {"enum": ["add_candidate", "hold_or_monitor", "watch", "avoid_or_underweight"]},
          "target_weight_range_pct": {
            "type": ["object", "null"],
            "properties": {
              "min": {"type": "number"},
              "max": {"type": "number"}
            },
            "required": ["min", "max"],
            "additionalProperties": false
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["lane_count", "promoted_count", "duplicate_exposure_ids", "portfolio_context_separation_status"],
      "properties": {
        "lane_count": {"type": "integer", "minimum": 1},
        "promoted_count": {"type": "integer", "minimum": 0},
        "duplicate_exposure_ids": {"type": "array", "maxItems": 0},
        "portfolio_context_separation_status": {"enum": ["partial_v1", "complete"]}
      }
    }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rank",
        "exposure_id",
        "lane_name",
        "taxonomy_tag",
        "bucket",
        "promoted",
        "challenger",
        "us_primary_etf",
        "us_alternative_etf",
        "scores",
        "market_evidence",
        "fundability_status",
        "desired_direction",
        "evidence_summary",
        "rejection_reason",
        "what_would_change"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "exposure_id": {"type": "string", "minLength": 1},
        "lane_name": {"type": "string", "minLength": 1},
        "taxonomy_tag": {"type": ["string", "null"]},
        "bucket": {"type": ["string", "null"]},
        "promoted": {"type": "boolean"},
        "challenger": {"type": "boolean"},
        "us_primary_etf": {"type": ["string", "null"]},
        "us_alternative_etf": {"type": ["string", "null"]},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methodology_base", "market_evidence_adjustment", "macro_adjustment", "donor_context_adjustment", "donor_final_rank_score"],
          "properties": {
            "methodology_base": {"type": "number"},
            "market_evidence_adjustment": {"type": "number"},
            "macro_adjustment": {"type": "number"},
            "donor_context_adjustment": {"type": "number"},
            "donor_final_rank_score": {"type": "number"}
          }
        },
        "market_evidence": {"type": "object"},
        "fundability_status": {"type": ["string", "null"]},
        "desired_direction": {"enum": ["add_candidate", "hold_or_monitor", "watch", "avoid_or_underweight"]},
        "target_weight_range_pct": {"type": ["object", "null"]},
        "evidence_summary": {"type": ["string", "null"]},
        "rejection_reason": {"type": ["string", "null"]},
        "what_would_change": {"type": ["string", "null"]},
        "invalidation": {"type": ["string", "null"]}
      }
    }
  }
}
